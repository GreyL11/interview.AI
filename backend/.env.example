# --- LLM (cloud; reasoning only, never raw audio or documents) ---
# Groq is the only cloud provider. The key is optional here: the desktop app
# stores it in the OS credential store instead, and this file is a development
# convenience that a packaged build deliberately ignores.
GROQ_API_KEY=
# The single place a model is named. Must be a model the account can use;
# an unknown one is reported as "model unavailable" rather than a generic
# failure. See https://console.groq.com/docs/models for the current list.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
# The SDK retries connection errors, 408, 429 and 5xx. It never retries a bad
# key or an unknown model, because the answer would be identical.
GROQ_MAX_RETRIES=2

# --- Scanned documents (OCR) ---
# A PDF page with fewer than this many extractable characters is treated as an
# image of text and sent to OCR. Not zero: scanners stamp headers and page
# numbers onto scanned pages.
OCR_MIN_CHARS_PER_PAGE=60
# Rasterisation resolution for OCR. Below ~200 accuracy drops sharply.
OCR_RENDER_DPI=220
# Ceiling on OCR'd pages per document, so one huge scan cannot hold the
# ingestion lock for an hour.
OCR_MAX_PAGES=60
# Cores OCR may use; 0 = a quarter of the machine, capped at four. Bounded so
# ingesting a scan during a live interview cannot starve transcription.
OCR_THREADS=0

# --- Local storage ---
DATA_DIR=./data

# --- Embeddings (ONNX backend, runs locally, no torch) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_MAX_TOKENS=256

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.25
RAG_OVERFETCH=4

# --- Session memory ---
MEMORY_MAX_TOKENS=1200

# --- Question detection (only final transcripts ever reach the LLM) ---
QUESTION_MIN_WORDS=2
QUESTION_MIN_CONFIDENCE=0.5
QUESTION_COALESCE_MS=1200
# How long a rejected setup fragment ("just write a character count program")
# stays eligible to be attached to the next accepted question. Sized for a
# multi-clause spoken scenario: "suppose you're working with X" / "and
# processing Y" / "how would you optimize it?" spans several seconds of
# speech, and a shorter window drops the head of the setup.
QUESTION_CONTEXT_WINDOW_MS=8000
# How long after a question is accepted a short fragment ("Why?", "How?")
# may still be treated as a follow-up instead of noise.
QUESTION_FOLLOWUP_WINDOW_MS=45000
# --- turn accumulation ------------------------------------------------------
# All of these are windows on the SPEECH clock and are spent only by a turn
# that is not yet answerable. A complete question and an obvious follow-up are
# held for 0ms regardless of every value here.
#
# Sizing: two fragments of one spoken turn have their speech_end timestamps
# separated by (pause + duration of the next fragment), and the next fragment
# is delivered one STT pass later. So accumulation only catches a continuation
# when pause + duration + stt <= hold, which for natural speech is 1.6-2.8s.
# Values under ~2s cannot assemble a fragmented question at all.
#
# A request that is grammatically whole but likely still has a constraint
# coming ("find two numbers").
QUESTION_STABILIZATION_MS=2500
# A request that is provably not whole yet ("Can you explain", "...what
# happens when", "Given an array of integers", "tell me about a time").
# Sending one of these can only ever be wrong, so it waits longest.
QUESTION_HOLD_INCOMPLETE_MS=3000
# After a fragment merged but the result still has no terminal "?", the turn
# has demonstrated that it arrives in pieces; the next piece gets this long.
# Restarted by each new fragment, which is what makes N fragments one call.
QUESTION_CONTINUATION_MS=2000
# Ceiling on one turn's total accumulation, and the merge window used while a
# turn is still accumulating. Must not be smaller than the holds above, or a
# held fragment outlives the window that would let its continuation merge and
# its words are dropped instead of assembled.
QUESTION_MAX_ACCUMULATION_MS=10000
# Logs every detector decision (accepted/rejected, category, confidence,
# reason) for inspecting real-world behavior during manual testing. Off by
# default; interviewer LOOPBACK speech only, never candidate MIC audio.
QUESTION_DETECTOR_DIAGNOSTICS=false

# --- Realtime ---
WS_REPLAY_BUFFER=200
# Set by the desktop shell when it spawns the backend; empty disables the check.
API_TOKEN=

# --- Audio capture (local only; audio is never uploaded) ---
# Off by default. Your microphone is transcribed for review only -- it never
# drives question detection -- but it was measured at 70% of all STT work,
# which is what pushed transcription past real time on a laptop CPU.
AUDIO_CAPTURE_MIC=false       # candidate, recorded for review
AUDIO_CAPTURE_LOOPBACK=true   # interviewer, drives question detection
AUDIO_QUEUE_FRAMES=200
# Low-pass the WASAPI loopback stream before decimating it to 16kHz. Without
# it, content above the 8kHz output Nyquist folds into the speech band (a
# 15kHz tone measured at ~1kHz, full amplitude). Off only to A/B the two arms
# on real interview audio. Does not affect mic capture, which PortAudio
# resamples itself.
AUDIO_LOOPBACK_ANTIALIAS=true

# --- question understanding -------------------------------------------------
# One classification call per COMPLETED interviewer turn, between deterministic
# finality and answer generation. Never runs on partial transcripts or on
# incomplete fragments. Turning it off degrades to the deterministic reading
# the detector already produces: answers still happen, context selection is
# just less precise.
QUESTION_UNDERSTANDING_ENABLED=true
# Hard budget. Far tighter than GROQ_TIMEOUT_SECONDS because this sits on the
# realtime path between a finished question and its answer -- past this the
# deterministic fallback is faster than the classifier.
QUESTION_UNDERSTANDING_TIMEOUT_MS=1500
# Empty means "use GROQ_MODEL". Split only if a smaller, faster model proves
# worth the extra configuration surface on real audio.
QUESTION_UNDERSTANDING_MODEL=

# --- interviewer-pasted material --------------------------------------------
# How close to a question a paste has to be for elapsed time alone to bind it,
# in either direction (paste-then-ask and ask-then-paste are the same event in
# different orders). Past this window the paste is not lost: it stays
# unclaimed, and a turn that demonstrably refers to provided material can
# still claim it. Was 10000, which dropped material while the interviewer was
# still reading the paste out loud.
CONTEXT_ATTACHMENT_WINDOW_MS=60000
# Per-attachment ceiling. Anything larger is rejected with a reason rather
# than truncated -- a partial table or query looks complete to the model and
# is worse than none at all.
CONTEXT_ATTACHMENT_MAX_CHARS=20000
# How many pastes one turn may carry (a schema, a query, an error, ...).
CONTEXT_ATTACHMENT_MAX_ITEMS=6

# --- Voice activity detection ---
VAD_THRESHOLD=0.5
VAD_START_FRAMES=2
VAD_SILENCE_MS=700
VAD_MIN_UTTERANCE_MS=300
VAD_MAX_UTTERANCE_MS=30000

# --- Speech to text (local faster-whisper) ---
STT_MODEL=distil-small.en
# auto = use an NVIDIA GPU when one genuinely works, CPU otherwise. The same
# build then runs on NVIDIA, AMD, Intel and in a VM with no configuration.
# cuda = demand the GPU and fail loudly without it. cpu = never probe.
STT_DEVICE=auto
STT_COMPUTE_TYPE=int8          # used on CPU
STT_CUDA_COMPUTE_TYPE=float16  # used when a GPU is selected
STT_BEAM_SIZE=5
STT_LANGUAGE=en
STT_PARTIAL_INTERVAL_MS=1000

# --- STT execution (see backend/PERFORMANCE.md) ---
# One CTranslate2 model instance serves every channel. Raising concurrency
# without matching num_workers just moves the queue into C++, so these two
# stay in sync automatically -- only change STT_INFERENCE_CONCURRENCY.
STT_INFERENCE_CONCURRENCY=1
# 0 = let CTranslate2 decide, which measured ~2.5x slower than an explicit
# count. Left at 0 the app now picks half the machine (2-8) rather than
# deferring. Set a number here to override.
STT_CPU_THREADS=0
# Load shedding. Transcription is real-time: past these ages the words arrive
# after they were useful, and running them starves the next utterance. 0
# disables shedding and restores the old unbounded-queue behaviour.
STT_MAX_JOB_AGE_SECONDS=25
STT_MAX_MIC_JOB_AGE_SECONDS=8
STT_ENABLE_PARTIALS=true
STT_PARTIAL_MIN_AUDIO_MS=500
STT_MAX_PARTIALS_PER_UTTERANCE=4
# Lower runs first. Every final outranks every partial, so a candidate final
# never waits behind an interviewer partial; loopback wins within each band.
STT_PRIORITY_LOOPBACK_FINAL=0
STT_PRIORITY_MIC_FINAL=1
STT_PRIORITY_LOOPBACK_PARTIAL=2
STT_PRIORITY_MIC_PARTIAL=3

LOG_LEVEL=INFO
