# --- LLM (cloud; reasoning only, never raw audio or documents) ---
# Both providers are optional and independent: Gemini-only, Groq-only, and
# both configured are all valid. With neither set the app still starts and
# typed practice works; the first question reports the missing key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_ENABLED=true

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_ENABLED=true

# --- LLM provider routing ---
# Preference order. A provider is skipped only when it is in cooldown or has
# no key. Groq leads by default because Gemini's free tier is the one that
# has produced 429s here -- this is NOT a measured latency claim. Reorder
# freely (e.g. "gemini,groq"), no code change needed.
LLM_PROVIDER_PRIORITY=groq,gemini
# Cooldown after a 429 (or repeated failures) when the provider sends no
# Retry-After header of its own.
LLM_PROVIDER_COOLDOWN_SECONDS=30
# Ceiling on a provider-supplied Retry-After.
LLM_PROVIDER_MAX_COOLDOWN_SECONDS=120
# A bad key won't recover quickly; back off harder before retrying it.
LLM_PROVIDER_AUTH_COOLDOWN_SECONDS=300
# Consecutive non-rate-limit failures before a provider is cooled down.
LLM_PROVIDER_FAILURE_THRESHOLD=3
# Let a consistently faster provider outrank the configured priority.
LLM_LATENCY_AWARE_ROUTING=true
# How much faster the challenger must be to displace the preferred provider
# (0.8 = at least 20% faster on median first-token latency, over 5 samples).
LLM_LATENCY_ROUTING_MARGIN=0.8

# --- Local storage ---
DATA_DIR=./data

# --- Embeddings (ONNX backend, runs locally, no torch) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_MAX_TOKENS=256

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.25
RAG_OVERFETCH=4

# --- Session memory ---
MEMORY_MAX_TOKENS=1200

# --- Question detection (only final transcripts ever reach the LLM) ---
QUESTION_MIN_WORDS=2
QUESTION_MIN_CONFIDENCE=0.5
QUESTION_COALESCE_MS=1200
# How long a rejected setup fragment ("just write a character count program")
# stays eligible to be attached to the next accepted question.
QUESTION_CONTEXT_WINDOW_MS=4000
# How long after a question is accepted a short fragment ("Why?", "How?")
# may still be treated as a follow-up instead of noise.
QUESTION_FOLLOWUP_WINDOW_MS=45000
# How long a question that looks mid-clause ("...what happens when") is held
# before asking it, to give a quick continuation a chance to supersede it.
QUESTION_STABILIZATION_MS=400
# Logs every detector decision (accepted/rejected, category, confidence,
# reason) for inspecting real-world behavior during manual testing. Off by
# default; interviewer LOOPBACK speech only, never candidate MIC audio.
QUESTION_DETECTOR_DIAGNOSTICS=false

# --- Realtime ---
WS_REPLAY_BUFFER=200
# Set by the desktop shell when it spawns the backend; empty disables the check.
API_TOKEN=

# --- Audio capture (local only; audio is never uploaded) ---
AUDIO_CAPTURE_MIC=true        # candidate, recorded for review
AUDIO_CAPTURE_LOOPBACK=true   # interviewer, drives question detection
AUDIO_QUEUE_FRAMES=200

# --- Voice activity detection ---
VAD_THRESHOLD=0.5
VAD_START_FRAMES=2
VAD_SILENCE_MS=700
VAD_MIN_UTTERANCE_MS=300
VAD_MAX_UTTERANCE_MS=30000

# --- Speech to text (local faster-whisper) ---
STT_MODEL=distil-small.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=5
STT_LANGUAGE=en
STT_PARTIAL_INTERVAL_MS=1000

# --- STT execution (see backend/PERFORMANCE.md) ---
# One CTranslate2 model instance serves every channel. Raising concurrency
# without matching num_workers just moves the queue into C++, so these two
# stay in sync automatically -- only change STT_INFERENCE_CONCURRENCY.
STT_INFERENCE_CONCURRENCY=1
STT_CPU_THREADS=0
STT_ENABLE_PARTIALS=true
STT_PARTIAL_MIN_AUDIO_MS=500
STT_MAX_PARTIALS_PER_UTTERANCE=4
# Lower runs first. Every final outranks every partial, so a candidate final
# never waits behind an interviewer partial; loopback wins within each band.
STT_PRIORITY_LOOPBACK_FINAL=0
STT_PRIORITY_MIC_FINAL=1
STT_PRIORITY_LOOPBACK_PARTIAL=2
STT_PRIORITY_MIC_PARTIAL=3

LOG_LEVEL=INFO
