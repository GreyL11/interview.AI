{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Call Assistant",
  "version": "0.1.0",
  "identifier": "com.callassistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Call Assistant",
        "width": 1280,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../../backend/dist/call-assistant-backend": "backend"
    },
    "shortDescription": "Local-first call assistant",
    "longDescription": "call assistant with local speech-to-text, local document retrieval, and cloud reasoning. For mock calls and settings where AI assistance is permitted.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
